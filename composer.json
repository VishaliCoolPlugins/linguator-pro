{
    "name": "linguator/linguator-pro",
    "description": "Linguator Pro – AI Multilingual WordPress",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "homepage": "https://linguator.com/",
    "authors": [
        {
            "name": "Cool Plugins",
            "email": "contact@coolplugins.net",
            "homepage": "https://coolplugins.net",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://linguator.com/support/",
        "forum": "https://linguator.com/forums/"
    },
    "require": {
        "php": ">=7.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^8.0|^9.0",
        "wp-coding-standards/wpcs": "^2.3",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7",
        "phpcompatibility/phpcompatibility-wp": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "LinguatorPro\\Admin\\": "admin/",
            "LinguatorPro\\Frontend\\": "frontend/",
            "LinguatorPro\\Includes\\": "includes/",
            "LinguatorPro\\includes\\": "includes/",
            "LinguatorPro\\Settings\\": "admin/settings/",
            "LinguatorPro\\Modules\\": "modules/",
            "LinguatorPro\\Integrations\\": "integrations/",
            "LinguatorPro\\Install\\": "install/"
        },
        "classmap": [
            "includes/",
            "admin/",
            "frontend/",
            "integrations/",
            "modules/",
            "admin/settings/",
            "install/"
        ],
        "exclude-from-classmap": [
            "includes/ai-providers/"
        ],
        "files": [
            "includes/helpers/functions.php",
            "includes/api/language-api.php",
            "includes/sync-menu/menu-sync-integration.php"
        ]
    },
    "scripts": {
        "phpcs": "phpcs --standard=WordPress --extensions=php --ignore=*/vendor/*,*/node_modules/* .",
        "phpcs:fix": "phpcbf --standard=WordPress --extensions=php --ignore=*/vendor/*,*/node_modules/* .",
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './node_modules/*' -exec php -l {} \\;"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "process-timeout": 0
    }
} 